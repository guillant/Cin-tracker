# Copiez ce fichier vers .env. Il n'est jamais exposé au navigateur.
# Option A : modèle OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Option B : modèle local Ollama (OPENAI_API_KEY peut rester vide)
# OPENAI_API_URL=http://127.0.0.1:11434/v1/chat/completions
# OPENAI_MODEL=qwen3:8b
# Délai max d'une réponse IA côté serveur (8000 à 60000 ms, défaut 20000 en local).
# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_COMPLETION_TOKENS=320
# AI_MAX_TOOL_CALLS=1

RAPIDAPI_KEY=
TMDB_API_KEY=
PORT=4173
# Comma-separated origins allowed to call the API (add the production PWA URL).
ALLOWED_ORIGINS=http://localhost,capacitor://localhost

# Protection des routes payantes (/api/assistant, /api/availability).
# Requêtes max par minute et par IP (défaut 20).
# API_RATE_LIMIT_PER_MINUTE=20
# Jeton partagé exigé dans l'en-tête X-CineTracker-Token (recommandé si le
# backend est public). Reporter la même valeur dans CONFIG.BACKEND_ACCESS_TOKEN.
# API_ACCESS_TOKEN=
